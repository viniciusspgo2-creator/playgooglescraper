// Prisma schema — Play Google Scraper
// Fase 2: banco multi-tenant completo (ADR-001 §1, ADR-003 §D3).
//
// Regras invioláveis:
// - Toda tabela de negócio tem `tenantId` NOT NULL (FK → Tenant, onDelete: Cascade).
// - `Lead` tem unicidade composta (tenantId, placeId) — dedup POR TENANT.
// - Provider PostgreSQL (Neon/Vercel). Campos de status permanecem String com
//   valores documentados (validados por Zod nas bordas) e JSON é String com
//   sufixo `Json` — portabilidade total e zero parsing implícito no client.
//
// Isolamento: 100% das queries de negócio passam por tenantDb(tenantId)
// (src/server/tenancy/tenant-guard.ts). Prova por tabela: bun run verify:isolation.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// ───────────────────────────── TENANT & IDENTIDADE ─────────────────────────────

model Tenant {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  /// trial | starter | pro | business (Fase 8 ativa cobrança)
  plan            String   @default("trial")
  /// Créditos de lead do ciclo (1 crédito = 1 lead extraído)
  leadCredits     Int      @default(500)
  leadCreditsUsed Int      @default(0)
  /// Assentos contratados (limite de usuários ativos + convidados)
  seats           Int      @default(3)
  locale          String   @default("pt-BR")
  /// Config do tenant (ex.: pesos do heat_score) — JSON string, Fase 3+
  settingsJson    String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users             User[]
  apiTokens         ApiToken[]
  searches          Search[]
  searchCells       SearchCell[]
  leads             Lead[]
  templates         Template[]
  campaigns         Campaign[]
  campaignLeads     CampaignLead[]
  creatives         Creative[]
  activities        Activity[]
  webhooks          Webhook[]
  webhookDeliveries WebhookDelivery[]
  suppressions      SuppressionEntry[]
  billingEvents     BillingEvent[]
}

model User {
  id              String    @id @default(cuid())
  tenantId        String
  /// Único global: login é por e-mail, 1 usuário pertence a 1 tenant.
  email           String    @unique
  /// null enquanto o convite não é aceito (status = "invited")
  passwordHash    String?
  name            String
  /// owner | admin | member — owner é o criador do tenant (1 por tenant)
  role            String    @default("member")
  /// active | invited | disabled
  status          String    @default("active")
  locale          String    @default("pt-BR")
  inviteToken     String?   @unique
  inviteExpiresAt DateTime?
  lastLoginAt     DateTime?
  /// Incremento invalida todas as sessões emitidas (A3, D2)
  tokenVersion    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, role])
  @@index([tenantId, status])
}

model ApiToken {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  /// SHA-256 do token bruto — o token em claro NUNCA é persistido
  tokenHash   String    @unique
  /// "pgs_live_xxx_ab12…ef34" — exibição segura na UI
  tokenPrefix String
  /// Escopos: ["verify","leads:read","leads:write"] — JSON string
  scopesJson  String    @default("[]")
  deviceLabel String?
  lastUsedAt  DateTime?
  useCount    Int       @default(0)
  revokedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

/// ───────────────────────────── MOTOR DE BUSCA (Fases 4/5) ─────────────────────────────

model Search {
  id          String    @id @default(cuid())
  tenantId    String
  term        String
  /// queued | running | paused | done | failed | cancelled
  status      String    @default("queued")
  /// stealth | moderate | fast | turbo (ADR-002 D3)
  speedMode   String    @default("moderate")
  /// {"latMin":..,"lngMin":..,"latMax":..,"lngMax":..} — bounding box da busca
  bboxJson    String?
  centerLat   Float?
  centerLng   Float?
  radiusKm    Float?
  /// Profundidade máxima da recursão Quadtree (padrão da spec: 4)
  maxDepth    Int       @default(4)
  /// ID local da extensão (UUID gerado no browser) — retomada e sync idempotente
  extId       String?
  cellsTotal  Int       @default(0)
  cellsDone   Int       @default(0)
  leadsFound  Int       @default(0)
  createdById String?
  startedAt   DateTime?
  finishedAt  DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cells  SearchCell[]
  leads  Lead[]

  @@index([tenantId, status, createdAt])
  @@unique([tenantId, extId])
}

/// Uma célula do grid Quadtree — persistida para retomada exata (spec §Resiliência)
model SearchCell {
  id        String    @id @default(cuid())
  tenantId  String
  searchId  String
  depth     Int       @default(0)
  latMin    Float
  lngMin    Float
  latMax    Float
  lngMax    Float
  /// pending | running | saturated | exhausted | failed
  status    String    @default("pending")
  found     Int       @default(0)
  attempts  Int       @default(0)
  /// ID local da célula na extensão — sync idempotente (retomada exata)
  extId     String?
  lastError String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  search Search @relation(fields: [searchId], references: [id], onDelete: Cascade)

  @@index([tenantId, searchId, status])
  @@unique([tenantId, extId])
}

model Lead {
  id              String    @id @default(cuid())
  tenantId        String
  /// Google place_id — dedup global POR TENANT (unicidade composta abaixo)
  placeId         String
  cid             String?
  name            String
  /// E.164 normalizado no servidor (Fase 3 valida com Zod)
  phoneE164       String?
  phoneRaw        String?
  website         String?
  /// none | social | own — base da classificação QUENTE/MORNO/FRIO
  websiteType     String    @default("none")
  temperature     String    @default("hot")
  /// Denormalização para índice (tenant_id, hasSite) da spec
  hasSite         Boolean   @default(false)
  /// 0–100, calculado no servidor na ingestão (Fase 3, fórmula documentada)
  heatScore       Int       @default(0)
  email           String?
  emailSource     String?
  address         String?
  lat             Float?
  lng             Float?
  plusCode        String?
  /// ["Barbearia", ...] — JSON string (SQLite sem Json)
  categoriesJson  String    @default("[]")
  /// "Barbearia, Salão" — denormalizado para busca (substituto do GIN)
  categoriesText  String    @default("")
  primaryCategory String?
  rating          Float?
  reviewsCount    Int?
  priceLevel      Int?
  hoursJson       String?
  photosCount     Int?
  claimed         Boolean?
  /// waiting | interested | refused | closed | production (Fase 6)
  stage           String    @default("waiting")
  /// Nota livre do vendedor (Fase 6)
  note            String?
  searchId        String?
  cellId          String?
  /// Estratégia dominante da extração: payload | dom | detail (ADR-002 D1)
  sourceStrategy  String?
  /// {"payload":["name","phone"], ...} — telemetria por campo
  sourcesJson     String?
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  search        Search?        @relation(fields: [searchId], references: [id], onDelete: SetNull)
  campaignLeads CampaignLead[]

  @@unique([tenantId, placeId])
  @@index([tenantId, heatScore])
  @@index([tenantId, hasSite])
  @@index([tenantId, stage])
  @@index([tenantId, createdAt])
}

/// ───────────────────────────── CAMPANHAS WHATSAPP (Fase 7) ─────────────────────────────

model Template {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  locale         String   @default("pt-BR")
  body           String
  /// ["nome","categoria","cidade"] — variáveis suportadas
  variablesJson  String   @default("[]")
  /// Variações para rotação anti-spam — JSON string
  variationsJson String   @default("[]")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@index([tenantId, locale])
}

model Campaign {
  id             String    @id @default(cuid())
  tenantId       String
  name           String
  templateId     String?
  /// draft | scheduled | running | paused | done | cancelled
  status         String    @default("draft")
  /// whatsapp (único canal na Fase 7)
  channel        String    @default("whatsapp")
  /// cloud_api | own_number — own_number exige aviso de risco exibido (spec)
  whatsappMode   String?
  minDelaySec    Int       @default(45)
  maxDelaySec    Int       @default(120)
  dailyLimit     Int       @default(200)
  startHour      Int       @default(8)
  endHour        Int       @default(20)
  warmupEnabled  Boolean   @default(true)
  scheduledAt    DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template  Template?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  leads     CampaignLead[]
  creatives Creative[]

  @@index([tenantId, status])
}

model CampaignLead {
  id              String    @id @default(cuid())
  tenantId        String
  campaignId      String
  leadId          String
  /// queued | sent | delivered | read | replied | failed | opted_out
  status          String    @default("queued")
  variationIndex  Int?
  sentAt          DateTime?
  deliveredAt     DateTime?
  readAt          DateTime?
  repliedAt       DateTime?
  nextFollowupAt  DateTime?
  /// Momento em que entrou na janela de envio (processador da fila)
  scheduledAt     DateTime?
  /// Snapshot da mensagem personalizada renderizada na hora do envio
  messageText     String?
  error           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([campaignId, leadId])
  @@index([tenantId, status])
  @@index([tenantId, campaignId, status])
}

model Creative {
  id        String   @id @default(cuid())
  tenantId  String
  campaignId String?
  fileKey   String
  fileName  String
  mimeType  String
  sizeBytes Int
  caption   String?
  createdAt DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([tenantId, campaignId])
}

/// ───────────────────────────── AUDITORIA, WEBHOOKS, LGPD, BILLING ─────────────────────────────

/// Log append-only de ações (sem FK para user/lead — linhas sobrevivem a deleções)
model Activity {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  leadId    String?
  /// auth.register | auth.login | token.created | token.revoked | ...
  type      String
  dataJson  String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model Webhook {
  id         String   @id @default(cuid())
  tenantId   String
  url        String
  /// Segredo HMAC das assinaturas (spec §API pública)
  secret     String
  /// ["lead.created","lead.stage_changed","search.completed","campaign.reply"]
  eventsJson String   @default("[]")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([tenantId, active])
}

model WebhookDelivery {
  id            String    @id @default(cuid())
  tenantId      String
  webhookId     String
  event         String
  payloadJson   String
  /// pending | ok | failed
  status        String    @default("pending")
  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  responseCode  Int?
  nextRetryAt   DateTime?
  createdAt     DateTime  @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([tenantId, webhookId, status])
}

/// Lista de supressão POR TENANT (LGPD: opt-out "sair"/"parar", bounce, manual)
model SuppressionEntry {
  id        String   @id @default(cuid())
  tenantId  String
  phoneE164 String
  /// opt_out | bounce | manual
  reason    String
  note      String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, phoneE164])
}

/// Eventos de billing idempotentes (Fase 8: Stripe + Mercado Pago)
model BillingEvent {
  id          String   @id @default(cuid())
  tenantId    String
  /// stripe | mercado_pago
  provider    String
  /// UNIQUE por provedor — idempotência de webhooks
  eventId     String
  type        String
  payloadJson String
  processedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([provider, eventId])
  @@index([tenantId, createdAt])
}

/// ───────────────────────────── PRÉ-FASE (Fase 1) ─────────────────────────────

/// Lista de acesso antecipado coletada na landing (dados reais, pré-auth).
/// Mantida por ADR-003 §D6-Notas; sem fluxo novo — onboarding é via register.
model WaitlistSignup {
  id        String   @id @default(cuid())
  email     String   @unique
  locale    String   @default("pt-BR")
  source    String   @default("landing")
  createdAt DateTime @default(now())
}
