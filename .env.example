# ═══════════════════════════════════════════════════════════════
# Play Google Scraper — variáveis de ambiente (Vercel + Neon)
# Copie para .env (local) ou cadastre na Vercel → Settings → Environment Variables
# ═══════════════════════════════════════════════════════════════

# ── OBRIGATÓRIAS ────────────────────────────────────────────────

# PostgreSQL (Neon): Connection string do painel do Neon (pooled connection).
# Formato: postgresql://usuario:senha@ep-xxxx-pooler.regiao.aws.neon.tech/banco?sslmode=require
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Segredo HMAC das sessões (cookie assinado). Gere com: openssl rand -hex 32
AUTH_SECRET=""

# URL canônica/base da aplicação SEM barra final. Usada em metadataBase,
# canonical, Open Graph, sitemap.xml, llms.txt e links de convite.
APP_URL="https://seu-dominio.vercel.app"   # sem barra final

# ── OPCIONAIS — ANALYTICS (SEO/GEO) ────────────────────────────

# Google Analytics 4 — ID de medida (G-XXXXXXXXXX).
# Sem valor, nenhum script de analytics é injetado.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Google Tag Manager — ID do container (GTM-XXXXXXX).
NEXT_PUBLIC_GTM_ID=""

# ── OPCIONAIS — BILLING (Fase 8) ───────────────────────────────
# Sem elas, o checkout responde 409 billing_provider_unconfigured (comportamento
# honesto esperado) e a ativação manual pelo owner continua disponível.

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
MERCADOPAGO_WEBHOOK_SECRET=""

# ── OPCIONAIS — E-MAIL (convites) ──────────────────────────────
# Sem RESEND_API_KEY, convites/caixa de saída ficam no log do servidor (console).

RESEND_API_KEY=""
MAIL_FROM=""

# ── OPCIONAIS — WHATSAPP CLOUD API (Fase 7) ────────────────────
# Sem elas, a fila marca mensagens como "prontas" (nunca "enviadas" — honesto).

WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
